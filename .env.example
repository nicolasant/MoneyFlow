# Configuração da Aplicação Finance Pro
# Copie este arquivo para .env e atualize os valores

# Ambiente de execução
FLASK_ENV=development

# Chave secreta para sessões (MUDE ISTO EM PRODUÇÃO!)
SECRET_KEY=sua-chave-secreta-segura-aqui

# Modo de Debug (False em produção)
DEBUG=False

# Endereço e porta do servidor
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Banco de dados
DATABASE=financas.db
